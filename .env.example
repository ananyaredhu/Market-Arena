# Copy to .env and fill in. Never commit .env.

# MOCK=1 makes every API route return fixtures (no LLM, no engine needed).
MOCK=1

# LLM_MODE=mock uses canned answers from fixtures; live uses the provider chain below.
LLM_MODE=mock

# Provider chain order, first available wins, the next is tried on failure.
LLM_PROVIDER_ORDER=groq,openrouter,ollama

# Free-tier keys (leave blank to skip a provider). Check each provider's current limits.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model names are defaults only. VERIFY they still exist on each provider before use.
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Per-call timeout (seconds) and how long a failing provider is skipped (seconds).
LLM_TIMEOUT=30
LLM_COOLDOWN=60

# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
