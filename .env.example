# Copy to .env and fill in. Never commit .env.

# MOCK=1 makes every API route return fixtures (no LLM, no engine needed).
MOCK=1

# LLM_MODE=mock uses canned answers from fixtures; live uses the provider chain below.
LLM_MODE=mock

# Provider chain order, first available wins, the next is tried on failure.
LLM_PROVIDER_ORDER=groq,openrouter,ollama

# Free-tier keys (leave blank to skip a provider). Check each provider's current limits.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model names are defaults only. VERIFY they still exist on each provider before use.
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Per-call timeout (seconds) and how long a failing provider is skipped (seconds).
LLM_TIMEOUT=60
LLM_COOLDOWN=60

# Evidence researcher (web search) uses SearXNG, a free open-source search engine you run locally: `make search-up`
# (needs Docker, see infra/searxng/). With SEARXNG_URL empty, research is skipped and the original priors are used.
# SEARCH_PROVIDER=none switches it off even when the URL is set.
SEARXNG_URL=http://localhost:8888
SEARCH_PROVIDER=searxng

# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
