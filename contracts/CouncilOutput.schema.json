  },
  "additionalProperties": true,
  "properties": {
    "competitor_reaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompetitorReaction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "experiments": {
      "items": {
        "$ref": "#/$defs/Experiment"
      },
      "title": "Experiments",
      "type": "array"
    },
    "fragility": {
      "title": "Fragility",
      "type": "number"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/Risk"
      },
      "title": "Risks",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "trend_context": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TrendContext"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trend Context"
    },
    "verdict": {
      "title": "Verdict",
      "type": "string"
    },
    "who_buys": {
      "items": {
        "type": "string"
      },
      "title": "Who Buys",
      "type": "array"
    },
    "who_rejects": {
      "items": {
        "type": "string"
      },
      "title": "Who Rejects",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "verdict",
    "confidence",
    "fragility",
    "who_buys",
    "who_rejects",
    "risks",
    "experiments"
