        "pass_threshold": {
          "title": "Pass Threshold",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "hypothesis",
        "pass_threshold",
        "kind"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": true,
      "properties": {
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "evidence",
        "metric"
      ],
      "title": "Risk",
      "type": "object"
    },
    "TrendContext": {
      "additionalProperties": true,
      "properties": {
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "trend": {
          "title": "Trend",
          "type": "string"
        },
        "used_in": {
          "title": "Used In",
          "type": "string"
        }
