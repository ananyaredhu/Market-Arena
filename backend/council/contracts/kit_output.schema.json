      "title": "KitAssets",
      "type": "object"
    },
    "KitOffline": {
      "additionalProperties": false,
      "properties": {
        "flyer": {
          "title": "Flyer",
          "type": "string"
        },
        "checklist": {
          "items": {
            "type": "string"
          },
          "title": "Checklist",
          "type": "array"
        },
        "price_board_test": {
          "items": {
            "type": "string"
          },
          "title": "Price Board Test",
          "type": "array"
        }
      },
      "required": [
        "flyer",
        "checklist"
      ],
      "title": "KitOffline",
      "type": "object"
    },
    "TrackingPlan": {
      "additionalProperties": false,
